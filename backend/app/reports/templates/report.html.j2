<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.title }} — {{ c.project.name }}</title>
<style>
  /* Вид — как у отчётов «Сканера», углы — угловатый вариант продукта (--radius 4px, --radius-sm 2px). */
  :root {
    --ink: #101828; --ink-2: #344054; --muted: #667085; --faint: #98a2b3;
    --line: #eaecf0; --bg: #ffffff; --panel: #f9fafb; --accent: #1d2b4f; --accent-2: #3e4c7a;
    --critical: {{ SEVERITY_HEX.critical }}; --high: {{ SEVERITY_HEX.high }};
    --medium: {{ SEVERITY_HEX.medium }}; --low: {{ SEVERITY_HEX.low }}; --info: {{ SEVERITY_HEX.info }};
    --good: #067647; --good-bg: #ecfdf3;
    --radius: 4px; --radius-sm: 2px;
  }
  @page { size: A4; margin: 20mm 16mm 18mm 16mm;
          @top-left { content: string(doctitle); font-family: Inter, "DejaVu Sans", sans-serif;
                      font-size: 7.5pt; color: #98a2b3; }
          @top-right { content: string(customer); font-family: Inter, "DejaVu Sans", sans-serif;
                       font-size: 7.5pt; color: #98a2b3; }
          @bottom-right { content: counter(page) " / " counter(pages);
                          font-family: Inter, "DejaVu Sans", sans-serif; font-size: 7.5pt; color: #98a2b3; } }
  @page cover { margin: 0; @top-left { content: none; } @top-right { content: none; }
                @bottom-right { content: none; } }
  * { box-sizing: border-box; }
  body { font-family: Inter, "DejaVu Sans", "Segoe UI", Arial, sans-serif; color: var(--ink-2);
         background: var(--bg); margin: 0 auto; max-width: 1100px; padding: 24px 16px 48px;
         font-size: 9.5pt; line-height: 1.5; }
  @media print { body { padding: 0; max-width: none; } }
  h1, h2, h3, h4 { color: var(--ink); font-weight: 600; }
  a { color: var(--accent-2); text-decoration: none; }
  .muted { color: var(--muted); }
  .zero { color: var(--faint); }

  .cover { background: var(--accent); color: #fff; border-radius: var(--radius); padding: 36px 36px 30px;
           margin-bottom: 28px; }
  .cover .kicker { text-transform: uppercase; letter-spacing: .14em; font-size: 7.5pt;
                   color: rgba(255,255,255,.7); font-weight: 600; }
  .cover h1 { color: #fff; font-size: 24pt; line-height: 1.2; margin: 10px 0 18px; font-weight: 700;
              letter-spacing: -.01em; string-set: doctitle content(); }
  .cover .customer { font-size: 12pt; color: #fff; font-weight: 600; string-set: customer content(); }
  .cover .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 14px; font-size: 8.5pt;
                 color: rgba(255,255,255,.75); }
  .cover .meta b { color: #fff; font-weight: 600; }
  .cover .score { display: flex; gap: 10px; margin-top: 26px; flex-wrap: wrap; }
  .cover .score div { flex: 1 1 110px; background: rgba(255,255,255,.08); border-radius: var(--radius);
                      padding: 10px 14px; }
  .cover .score small { display: block; font-size: 7pt; letter-spacing: .1em; text-transform: uppercase;
                        color: rgba(255,255,255,.65); }
  .cover .score b { display: block; font-size: 17pt; color: #fff; font-weight: 600; margin-top: 2px; }
  .cover .legal { margin-top: 26px; font-size: 7.5pt; color: rgba(255,255,255,.55); }
  @media print {
    .cover { page: cover; border-radius: 0; margin: 0; padding: 70mm 22mm 0; height: 297mm;
             page-break-after: always; }
    .cover h1 { font-size: 30pt; }
    .cover .legal { position: absolute; bottom: 18mm; left: 22mm; right: 22mm; }
  }

  h2 { font-size: 15pt; margin: 34px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line);
       page-break-after: avoid; letter-spacing: -.005em; }
  h2 .n { color: var(--accent-2); font-weight: 500; margin-right: 8px; font-size: 11pt; vertical-align: 2px; }
  h3 { font-size: 11pt; margin: 22px 0 10px; page-break-after: avoid; }
  .lead { color: var(--muted); margin: -4px 0 14px; page-break-after: avoid; }

  .kpis { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 12px; }
  .kpi { flex: 1 1 120px; border: 1px solid var(--line); border-radius: var(--radius); padding: 11px 14px;
         background: var(--bg); page-break-inside: avoid; }
  .kpi small { display: block; color: var(--muted); font-size: 7pt; font-weight: 600; letter-spacing: .08em;
               text-transform: uppercase; }
  .kpi b { display: block; font-size: 20pt; line-height: 1.2; margin-top: 4px; color: var(--ink);
           font-weight: 600; letter-spacing: -.01em; }
  .kpi .sub { font-size: 8pt; color: var(--muted); }
  .kpi.good { border-top: 3px solid var(--good); } .kpi.good b { color: var(--good); }
  .kpi.bad { border-top: 3px solid var(--high); } .kpi.bad b { color: #c4320a; }
  .kpi.accent { border-top: 3px solid var(--accent); }
  .up { color: #c4320a; font-weight: 600; } .down { color: var(--good); font-weight: 600; }
  .cards { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 12px; }
  .card { flex: 1 1 300px; border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px 10px;
          page-break-inside: avoid; background: var(--bg); }
  .card h4 { margin: 0 0 8px; font-size: 7.5pt; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  svg.chart { display: block; width: 100%; height: auto; max-width: 460px; margin: 0 auto; }
  svg.chart[data-chart="weeks"], svg.chart[data-chart="assignees"] { max-width: 820px; }
  .points { margin: 4px 0 0; padding: 0; list-style: none; }
  .points li { position: relative; padding: 7px 0 7px 18px; border-bottom: 1px solid var(--line); }
  .points li:last-child { border-bottom: none; }
  .points li::before { content: ""; position: absolute; left: 2px; top: 13px; width: 6px; height: 6px;
                       background: var(--accent-2); }

  .sev { display: inline-block; padding: 1px 8px 1px 7px; border-radius: var(--radius-sm); font-size: 7.5pt;
         font-weight: 600; white-space: nowrap; line-height: 1.6; }
  .sev::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
                 margin-right: 5px; vertical-align: 1px; background: currentColor; }
  .sev-critical { background: #fef3f2; color: #b42318; }
  .sev-high { background: #fff4ed; color: #c4320a; }
  .sev-medium { background: #fffaeb; color: #b54708; }
  .sev-low { background: #eff8ff; color: #175cd3; }
  .sev-info { background: #f2f4f7; color: #475467; }
  .tag { display: inline-block; padding: 0 6px; border-radius: var(--radius-sm); font-size: 7.5pt;
         font-weight: 600; background: #fef3f2; color: #b42318; margin-left: 4px; }
  .status { font-size: 8pt; color: var(--muted); white-space: nowrap; font-weight: 500; }
  .ok { color: var(--good); } .warn { color: #b54708; }
  .note { border-left: 3px solid var(--accent-2); background: var(--panel); padding: 6pt 9pt; margin: 6pt 0 12pt;
          font-size: 8.5pt; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .note.warnbox { border-left-color: #f79009; background: #fffaeb; }

  table { width: 100%; border-collapse: collapse; margin: 6px 0 14px; }
  th { text-align: left; font-size: 7pt; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
       color: var(--muted); padding: 7px 8px; border-bottom: 1px solid var(--line); background: var(--panel); }
  td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  tr { page-break-inside: avoid; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  td.total, tr.total td { font-weight: 600; color: var(--ink); }
  .wrap { overflow-x: auto; }
  table.fixed { table-layout: fixed; }
  table.fixed .status { white-space: normal; }
  @media print { .wrap table { font-size: 8.5pt; } }
  td.idx { color: var(--faint); white-space: nowrap; }
  td.title b { color: var(--ink); font-weight: 600; }
  .src { display: block; color: var(--muted); font-size: 8pt; margin-top: 2px; }
  .mono { font-family: "DejaVu Sans Mono", Menlo, Consolas, monospace; font-size: 8pt; }
  .footer-note { color: var(--muted); font-size: 8pt; margin-top: 28px; padding-top: 10px; border-top: 1px solid var(--line); }
</style>
</head>
<body>
{% macro sev(s) %}<span class="sev sev-{{ s }}">{{ SEVERITY_LABELS[s] }}</span>{% endmacro %}
{% macro n(v) %}<td class="num{% if not v %} zero{% endif %}">{{ v }}</td>{% endmacro %}
{% macro signed(v) %}{% if v > 0 %}<span class="up">+{{ v }}</span>{% elif v < 0 %}<span class="down">−{{ -v }}</span>{% else %}±0{% endif %}{% endmacro %}
{% set v = r.totals.vulns %}

<section class="cover">
  <div class="kicker">Устранение уязвимостей · отчёт о ходе работ{% if r.context.variant == "brief" %} · краткая версия{% endif %}</div>
  <h1>{{ c.title }}</h1>
  <div class="customer">{{ c.project.client or c.project.name }}</div>
  <div class="meta">
    <span>Проект: <b>{{ c.project.name }}</b></span>
    {% if c.project.contract_ref %}<span>Договор: <b>{{ c.project.contract_ref }}</b></span>{% endif %}
    <span>Период: <b>{{ c.period.label }}</b></span>
    <span>Сформирован: <b>{{ c.generated_local }} ({{ c.period.timezone }})</b></span>
    {% if c.author %}<span>Сформировал: <b>{{ c.author }}</b></span>{% endif %}
  </div>
  <div class="score">
    <div><small>Открыто на начало</small><b>{{ v.start }}</b></div>
    <div><small>Закрыто и подтверждено</small><b>{{ v.fixed }}</b></div>
    <div><small>Появилось</small><b>{{ v.appeared }}</b></div>
    <div><small>Открыто на конец</small><b>{{ v.end }}</b></div>
  </div>
  <div class="legal">Конфиденциально. Отчёт сформирован по данным повторных проверок «Сканера» и предназначен
  только для заказчика и исполнителей работ.</div>
</section>

<h2><span class="n">01</span>Резюме</h2>
<div class="kpis">
  <div class="kpi accent"><small>Открыто на начало периода</small><b>{{ v.start }}</b><span class="sub">уязвимостей</span></div>
  <div class="kpi good"><small>Закрыто и подтверждено</small><b>{{ v.fixed }}</b><span class="sub">повторной проверкой сканера</span></div>
  <div class="kpi"><small>Появилось</small><b>{{ v.appeared }}</b><span class="sub">{% if v.regression %}и вернулось после исправления: {{ v.regression }}{% else %}новых за период{% endif %}</span></div>
  <div class="kpi"><small>Открыто на конец</small><b>{{ v.end }}</b><span class="sub">{{ signed(v.end - v.start) }} за период</span></div>
</div>
<div class="kpis">
  <div class="kpi"><small>Заявок подтверждено</small><b>{{ r.totals.tickets_verified }}</b><span class="sub">закрыты за период</span></div>
  <div class="kpi"><small>Заявок осталось</small><b>{{ r.totals.tickets_open }}</b><span class="sub">из {{ r.totals.tickets_total }} всего</span></div>
  <div class="kpi"><small>Исключений</small><b>{{ r.totals.tickets_exceptions }}</b><span class="sub">принятый риск и ложные срабатывания</span></div>
  <div class="kpi{% if r.totals.hosts_unverified %} bad{% endif %}"><small>Не проверено</small><b>{{ r.totals.hosts_unverified }}</b><span class="sub">хостов в открытых заявках</span></div>
</div>

<h3>Главное</h3>
<ul class="points">
  {% for p in r.key_points %}<li>{{ p }}</li>{% endfor %}
</ul>
{% if c.tickets_as_of_now %}
<div class="note">Период закончился раньше даты формирования. Движение уязвимостей посчитано на границы периода,
а списки заявок, исполнители и исключения показаны на {{ c.generated_local }}.</div>
{% endif %}

<div class="cards">
  <div class="card"><h4>Движение за период</h4>{{ charts.waterfall }}</div>
  <div class="card"><h4>Открыто на конец периода</h4>{{ charts.severity }}</div>
</div>

<h3>По уровням опасности</h3>
<div class="wrap"><table>
  <tr><th>Уровень</th><th class="num">На начало</th><th class="num">Закрыто</th><th class="num">Появилось</th><th class="num">Регрессии</th><th class="num">На конец</th></tr>
  {% for s in r.by_severity %}
  <tr><td>{{ sev(s.severity) }}</td>{{ n(s.start) }}{{ n(s.fixed) }}{{ n(s.appeared) }}{{ n(s.regression) }}<td class="num total">{{ s.end }}</td></tr>
  {% endfor %}
  <tr class="total"><td>Всего</td><td class="num">{{ v.start }}</td><td class="num">{{ v.fixed }}</td><td class="num">{{ v.appeared }}</td><td class="num">{{ v.regression }}</td><td class="num">{{ v.end }}</td></tr>
</table></div>

<h3>По неделям</h3>
<div class="card">{{ charts.weeks }}</div>

<h2><span class="n">02</span>Что закрыто и подтверждено</h2>
<p class="lead">Уязвимость считается закрытой, только когда прогон «Сканера» полностью проверил хост и модуль
и не нашёл её. Если хост был недоступен или проверка неполная, результат — «не проверено».</p>
<h3>Прогоны за период</h3>
{% if r.runs %}
<div class="wrap"><table>
  <tr><th>Дата</th><th>Прогон</th><th>Вид</th><th class="num">Закрыто</th><th class="num">Появилось</th><th class="num">Регрессии</th></tr>
  {% for run in r.runs %}
  <tr><td class="idx">{{ run.finished_local }}</td>
      <td>{% if run.url %}<a href="{{ run.url }}">{{ run.name or "Прогон" }}</a>{% else %}{{ run.name or "Прогон" }}{% endif %}<span class="src">№{{ run.scanner_run_id }} «Сканера»</span></td>
      <td>{{ run.kind_label }}</td>{{ n(run.fixed) }}{{ n(run.appeared) }}{{ n(run.regression) }}</tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">За период прогонов не было.</p>{% endif %}

{% if c.variant == "full" %}
<h3>Подтверждённые заявки</h3>
{% if r.verified %}
<div class="wrap"><table class="fixed">
  <colgroup><col style="width:5%"><col style="width:32%"><col style="width:13%"><col style="width:13%"><col style="width:8%"><col style="width:11%"><col style="width:18%"></colgroup>
  <tr><th>№</th><th>Заявка</th><th>Уровень</th><th>Исполнитель</th><th class="num">Хостов</th><th class="num">Закрыто</th><th>Подтверждение</th></tr>
  {% for t in r.verified %}
  <tr><td class="idx">{{ t.id }}</td>
      <td class="title"><b>{{ t.title }}</b><span class="src">{{ t.kind_label }}{% if t.os %} · {{ t.os }}{% endif %}</span></td>
      <td>{{ sev(t.severity) }}</td><td>{{ t.assignee or "—" }}</td>
      <td class="num">{{ t.hosts_confirmed }}/{{ t.hosts }}</td>{{ n(t.fixed_vulns) }}
      <td><span class="ok">{{ t.closed_local }}</span>{% if t.evidence.scanner_run_id %}<span class="src">{% if t.evidence.url %}<a href="{{ t.evidence.url }}">прогон №{{ t.evidence.scanner_run_id }}</a>{% else %}прогон №{{ t.evidence.scanner_run_id }}{% endif %}{% if t.evidence.kind == "verification" %} · повторная проверка{% endif %}</span>{% endif %}</td></tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">За период подтверждённых заявок нет.</p>{% endif %}
{% endif %}

<h2><span class="n">03</span>Что осталось</h2>
{% if charts.hosts %}<div class="card"><h4>Хосты с наибольшим числом открытых уязвимостей</h4>{{ charts.hosts }}</div>{% endif %}
{% if c.variant == "full" %}
<h3>Открытые заявки</h3>
{% if r.remaining %}
<div class="wrap"><table class="fixed">
  <colgroup><col style="width:5%"><col style="width:36%"><col style="width:13%"><col style="width:14%"><col style="width:13%"><col style="width:9%"><col style="width:10%"></colgroup>
  <tr><th>№</th><th>Заявка</th><th>Уровень</th><th>Статус</th><th>Исполнитель</th><th class="num">Хостов</th><th class="num">Открыто</th></tr>
  {% for t in r.remaining %}
  <tr><td class="idx">{{ t.id }}</td>
      <td class="title"><b>{{ t.title }}</b>{% if t.is_regression %}<span class="tag">регрессия</span>{% endif %}<span class="src">{{ t.kind_label }}{% if t.os %} · {{ t.os }}{% endif %}{% if t.hosts_unverified %} · <span class="warn">не проверено хостов: {{ t.hosts_unverified }}</span>{% endif %}</span></td>
      <td>{{ sev(t.severity) }}</td><td><span class="status">{{ t.status_label }}</span></td><td>{{ t.assignee or "—" }}</td>
      <td class="num">{{ t.hosts }}</td>{{ n(t.open_vulns) }}</tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">Открытых заявок нет.</p>{% endif %}
{% else %}
<p class="muted">Открытых заявок: {{ r.totals.tickets_open }}. Список заявок — в полной версии отчёта.</p>
{% endif %}

<h2><span class="n">04</span>По исполнителям</h2>
<p class="lead">Открытые заявки — по текущему исполнителю; «Подтверждено» и «Закрыто уязв.» — за период.</p>
{% if charts.assignees %}<div class="card"><h4>Открытые заявки по уровням</h4>{{ charts.assignees }}</div>{% endif %}
{% if r.assignees %}
<div class="wrap"><table>
  <tr><th>Исполнитель</th><th class="num">Открыто заявок</th><th class="num">В работе</th><th class="num">Ждут проверки</th><th class="num">Открыто уязв.</th><th class="num">Подтверждено заявок</th><th class="num">Закрыто уязв.</th></tr>
  {% for p in r.assignees %}
  <tr><td>{{ p.name }}</td>{{ n(p.open) }}{{ n(p.in_work) }}{{ n(p.awaiting_check) }}{{ n(p.open_vulns) }}{{ n(p.verified) }}{{ n(p.fixed_vulns) }}</tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">Заявок нет.</p>{% endif %}

<h2><span class="n">05</span>По группам активов</h2>
<p class="lead">Группы — из «Сканера». Хост из нескольких групп учитывается в каждой; хосты без группы — отдельной строкой.</p>
{% if r.groups %}
<div class="wrap"><table>
  <tr><th>Группа</th><th class="num">Хостов</th><th class="num">На начало</th><th class="num">Закрыто</th><th class="num">Появилось</th><th class="num">Регрессии</th><th class="num">На конец</th></tr>
  {% for g in r.groups %}
  <tr><td>{{ g.name }}</td><td class="num">{{ g.hosts }}</td>{{ n(g.start) }}{{ n(g.fixed) }}{{ n(g.appeared) }}{{ n(g.regression) }}<td class="num total">{{ g.end }}</td></tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">Уязвимостей нет.</p>{% endif %}

<h2><span class="n">06</span>Исключения</h2>
<p class="lead">Действующие решения не устранять уязвимость: принятый риск с обоснованием и утверждающим, ложные срабатывания.
Дата пересмотра — когда решение нужно подтвердить заново.</p>
{% if r.exceptions %}
<div class="wrap"><table class="fixed">
  <colgroup><col style="width:28%"><col style="width:14%"><col style="width:30%"><col style="width:14%"><col style="width:9%"><col style="width:5%"></colgroup>
  <tr><th>Заявка</th><th>Вид</th><th>Обоснование</th><th>Утвердил</th><th>Пересмотр</th><th class="num">Уязв.</th></tr>
  {% for e in r.exceptions %}
  <tr><td class="title"><b>№{{ e.ticket_id }} {{ e.ticket_title }}</b><span class="src">{{ SEVERITY_LABELS[e.severity] }}</span></td>
      <td>{{ e.kind_label }}</td>
      <td>{{ e.reason }}{% if e.measures %}<span class="src">Меры: {{ e.measures }}</span>{% endif %}</td>
      <td>{{ e.approver or "—" }}{% if e.approved_local %}<span class="src">{{ e.approved_local }}</span>{% endif %}</td>
      <td>{{ e.review_local or "—" }}</td>{{ n(e.vulns) }}</tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">Действующих исключений нет.</p>{% endif %}

<div class="footer-note">
  Как считается: состояние уязвимости на дату — по последнему событию прогонов «Сканера» до этой даты
  (нашёл, подтвердил исправление, нашёл снова). На конец периода = на начало + появилось + регрессии − закрыто.
  Границы периода — по часовому поясу {{ c.period.timezone }}. Сроки устранения в отчёт не включены.
</div>
</body>
</html>
