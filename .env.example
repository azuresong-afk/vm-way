# «Устранение» — переменные окружения. Скопируйте в .env и заполните.
# Секреты не коммитьте: .env в .gitignore.

# Подпись токенов доступа (HMAC). Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
VM_SECRET_KEY=
# Ключ шифрования секретов (AES-GCM, 32 байта в base64). Сгенерировать:
# python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
VM_ENCRYPTION_KEY=

# Подключение к БД (в Docker Compose задаётся автоматически).
VM_DATABASE_URL=postgresql+psycopg://vm:vm@127.0.0.1:15433/vm

# Режим входа: local — свой вход; platform — через «Платформу» (этап 3).
VM_AUTH_MODE=local
# Время жизни токена доступа, минут.
VM_TOKEN_TTL_MINUTES=480

# Первый администратор: создаётся при старте, если пользователей ещё нет.
VM_ADMIN_USERNAME=admin
VM_ADMIN_PASSWORD=

# Демо-режим: проект «Демо: АО «Северный порт»» и пользователи manager, engineer, engineer2, viewer
# с паролем VM_DEMO_PASSWORD. Только для стенда, не для работы с заказчиком.
VM_DEMO=0
VM_DEMO_PASSWORD=

# Адрес веб-интерфейса «Сканера» для ссылок «Открыть в Сканере».
VM_SCANNER_WEB_URL=
