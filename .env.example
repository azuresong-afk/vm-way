# «Устранение» — переменные окружения. Скопируйте в .env и заполните
# (или выполните scripts/gen-env.sh — он заполнит секреты случайными значениями).
# Секреты не коммитьте: .env в .gitignore. Значения CHANGE_ME контейнер app
# не примет и не стартует (причина — в docker compose logs app).

# ---- Секреты -------------------------------------------------------------------
# Подпись токенов доступа (HMAC), не короче 32 символов.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VM_SECRET_KEY=CHANGE_ME
# Ключ шифрования секретов (пароли сервисных учёток «Сканера», SSH-учётки хостов): AES-GCM, 32 байта в base64.
# Сгенерировать: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# ВАЖНО: храните вместе с резервными копиями — без него пароли источников из копии не расшифруются.
VM_ENCRYPTION_KEY=CHANGE_ME

# ---- База данных (сервис db) ------------------------------------------------------
# В Docker Compose адрес БД для API собирается из этих трёх переменных.
# Пароль — только буквы и цифры: он подставляется в адрес подключения.
POSTGRES_DB=vm
POSTGRES_USER=vm
POSTGRES_PASSWORD=CHANGE_ME
# Запуск API без Docker (разработка) — полный адрес БД:
# VM_DATABASE_URL=postgresql+psycopg://vm:ПАРОЛЬ@127.0.0.1:15433/vm

# ---- Порты хоста (контракт «Платформы»: web 18081, api 18001, db 15433) ------------
VM_WEB_PORT=18081
# Адрес хоста, на котором слушает веб. По умолчанию все интерфейсы (HTTP!). За обратным прокси
# с TLS на этом же сервере поставьте 127.0.0.1 — см. docs/INSTALL.md, раздел 5.
VM_WEB_BIND=0.0.0.0
# Адрес или подсеть обратного прокси, чьему заголовку X-Forwarded-For веб верит (адрес клиента
# в журнале аудита). Для прокси на этом же сервере — подсеть Docker, обычно 172.16.0.0/12.
VM_TRUSTED_PROXY=127.0.0.1
# API и БД слушают только 127.0.0.1 хоста (отладка, резервные копии).
VM_API_PORT=18001
VM_DB_PORT=15433

# ---- Вход -------------------------------------------------------------------------
# Режим входа: local — свой вход; platform — через «Платформу» (появится на этапе 3).
VM_AUTH_MODE=local
# Время жизни токена доступа, минут.
VM_TOKEN_TTL_MINUTES=480
# Первый администратор: создаётся при старте, если пользователей ещё нет.
# Пароль не короче 10 символов; потом его можно сменить в «Пользователях».
VM_ADMIN_USERNAME=admin
VM_ADMIN_PASSWORD=CHANGE_ME

# ---- Демо-стенд --------------------------------------------------------------------
# 1 — проект «Демо: АО «Северный порт»», встроенный мок «Сканера» (mock://demo: 3 ОС,
# 20 хостов, три плановых прогона) и пользователи manager, engineer, engineer2, viewer
# с паролем VM_DEMO_PASSWORD (не короче 10 символов). Только для стенда, не для работы с заказчиком.
VM_DEMO=0
VM_DEMO_PASSWORD=
# Разрешить источники mock:// без демо-режима (только для тестов).
VM_ALLOW_MOCK_SOURCES=0

# ---- «Сканер» ------------------------------------------------------------------------
# Адрес веб-интерфейса «Сканера» для ссылок «Открыть в Сканере», например https://scanner.example.ru
VM_SCANNER_WEB_URL=

# ---- Фоновые задачи --------------------------------------------------------------------
# Потоков пула коротких задач (импорт, опрос источников, шаги повторных проверок) и пула раскаток.
# Проверка не держит поток, пока ждёт прогон «Сканера»; раскатки идут в своём пуле.
VM_JOBS_WORKERS=4
VM_JOBS_LONG_WORKERS=4
# Как часто планировщик запускает задачи, у которых подошёл срок, с.
# VM_JOBS_TICK_SECONDS=1
# Временная ошибка (сеть, 5xx «Сканера») повторяется до 3 попыток: пауза перед первым повтором, с;
# каждый следующий повтор — вчетверо позже.
VM_JOBS_RETRY_SECONDS=30
# Сроки хранения, дней (0 — не чистить): завершённые фоновые задачи; события outbox — доставленные
# и недоставленные (пока получателя нет; те же события остаются в журнале аудита).
VM_JOBS_RETENTION_DAYS=30
VM_OUTBOX_RETENTION_DAYS=30
VM_OUTBOX_UNDELIVERED_RETENTION_DAYS=90
# Опрос источников с автоимпортом (интервал — в настройках источника).
VM_POLL_ENABLED=1
# Повторная проверка: как часто спрашивать «Сканер» о прогоне и сколько ждать максимум.
VM_VERIFY_POLL_SECONDS=5
VM_VERIFY_TIMEOUT_MINUTES=240
# Попыток дождаться БД при старте контейнера app (по 2 с).
VM_DB_WAIT_ATTEMPTS=30
# Только для тестов: задачи исполняются сразу в запросе, без пула потоков.
# VM_JOBS_INLINE=0

# ---- Раскатки ------------------------------------------------------------------------
# Сколько секунд ждать хост после перезагрузки и как часто пробовать подключиться.
VM_ROLLOUT_REBOOT_TIMEOUT_SECONDS=600
VM_ROLLOUT_RECONNECT_SECONDS=10

# ---- Сборка и версия -------------------------------------------------------------------
# Тег образов app и web (docker compose build / up).
VM_IMAGE_TAG=local
# Версия продукта в манифесте и /health. Задана в коде и меняется с обновлением —
# переопределяйте только для собственной сборки.
# VM_PRODUCT_VERSION=0.1.0
